# ================================================================
#  AI Disaster Intelligence Platform — Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to Git!
# ================================================================

# ── Groq Cloud API (for fast, free RAG situation reports) ────
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── Database (Simple SQLAlchemy with SQLite default) ─────────
# Default is zero-config local SQLite. (e.g., sqlite:///./disaster.db)
# Or standard SQL: postgresql://user:password@localhost:5432/disaster_intel
DATABASE_URL=sqlite:///./disaster.db

# ── MongoDB (for Vector Embeddings & Document Store) ──────────
# Local MongoDB default or MongoDB Atlas connection URI
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=disaster_intelligence

# ── Backend Server ────────────────────────────────────────────
# Used by uvicorn when starting the backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Frontend ──────────────────────────────────────────────────
# The React dev server URL (for CORS)
FRONTEND_URL=http://localhost:3000
